# Existing GraphQL tools (optional when using CEWS-only mode)
FILENET_URL=https://your-server/content-services-graphql/graphql

# Shared FileNet credentials. Keep the password outside source control.
FILENET_USERNAME=dadmin
FILENET_PASSWORD=change-me
REPOSITORY_ID=ECM

# Traditional FileNet Content Engine Web Services (CEWS)
FILENET_CEWS_ENDPOINT=https://WIN-1GPQ0NALNPB:9443/wsi/FNCEWS40MTOM/
FILENET_CEWS_WSDL=https://WIN-1GPQ0NALNPB:9443/wsi/FNCEWS40MTOM?WSDL
FILENET_REPOSITORY_ID=ECM
FILENET_CEWS_AUTH=basic

# The lab uses a self-signed WebSphere certificate. Use true with a trusted certificate.
FILENET_TLS_REJECT_UNAUTHORIZED=false
FILENET_CEWS_LOCALE=en-US
# FILENET_CEWS_TIMEZONE=UTC
